# Copy to .env (docker compose) or apps/web/.env.local (npm run dev). Placeholders only; never commit real values.

# Web app -------------------------------------------------------------------
# PostgreSQL connection. Unset = embedded PGlite (local .data/ or ephemeral /tmp on serverless).
DATABASE_URL=
# EDA worker. Unset = recorded real-run evidence + in-process Yosys (WASM); other stages report BLOCKED_TOOL_UNAVAILABLE.
WORKER_URL=
WORKER_TOKEN=change-me-to-a-long-random-string

# AI providers: keys are referenced by name from the Tools & AI page and must start with DEVIN_AI_.
# The default is the built-in deterministic engine (no AI account needed).
DEVIN_AI_ANTHROPIC_API_KEY=
DEVIN_AI_LOCAL_LLM_API_KEY=

# docker compose ----------------------------------------------------------------
POSTGRES_PASSWORD=change-me
